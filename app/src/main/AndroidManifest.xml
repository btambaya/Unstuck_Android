<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity signal for the sync freshness owner: a network that comes back
         (tunnel, wifi→cellular) means everything written during the gap was never
         broadcast (postgres_changes has no replay), so we catch up at once instead
         of waiting for the next 60s floor pull. Read-only, no location implication. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Punctual pre-task reminders ("5 min before") + reschedule after reboot.
         SCHEDULE_EXACT_ALARM is user-grantable and we fall back to inexact alarms if
         denied (ReminderScheduler.setAlarm). We deliberately do NOT request the
         restricted USE_EXACT_ALARM — Play limits it to alarm-clock/calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Assistant voice: on-device speech-to-text dictation (TTS needs no perm). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Realtime voice: communication mode + routing for hardware echo cancellation. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- "Unstuck calls you" (C1-android): the ring shows full-screen over the lock
         screen (API 34: special access, pre-granted only to apps Play classifies
         as calling — declared on the Play form; otherwise the ring degrades to a
         heads-up and Settings › Calls offers ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT),
         the in-call voice service is a `microphone` foreground service started
         ONLY from the Answer tap, and the ring channel vibrates. WAKE_LOCK: the
         ring activity keeps the screen on while it rings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (Android 11+): see the system speech recognition + TTS
         services so SpeechRecognizer / TextToSpeech resolve. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".UnstuckApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unstuck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Unstuck"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth / magic-link callback (Supabase auth + Google calendar bounce). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unstuck" />
            </intent-filter>
        </activity>

        <!-- "Unstuck calls you": the full-screen ring. Over the keyguard with the
             screen turned on, its own task kept out of recents, never exported (the
             CallStyle notification's PendingIntents target it by component), singleTop
             so a shade "Answer" re-enters the ringing instance. -->
        <activity
            android:name=".calls.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Unstuck" />

        <!-- The ring's background outcomes: the 30 s missed alarm, the shade's
             Decline / Snooze. Not exported (explicit-component PendingIntents only). -->
        <receiver
            android:name=".calls.MissedCallReceiver"
            android:exported="false" />

        <!-- The in-call voice conversation (calls/CallVoiceService): a microphone
             foreground service, started only from IncomingCallActivity's Answer tap. -->
        <service
            android:name=".calls.CallVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Foreground focus-session timer (chronometer notification). -->
        <service
            android:name=".surface.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer" />
        </service>

        <!-- Live-notification / check-in action buttons (Pause/Resume/Snooze/End/Capture). -->
        <receiver
            android:name=".surface.NotificationActionReceiver"
            android:exported="false" />

        <!-- Pre-task reminder alarm fires. NOT exported: the alarm PendingIntents
             target it by explicit component from this app, so delivery still works,
             while no other app can inject spoofed notification extras. -->
        <receiver
            android:name=".surface.ReminderReceiver"
            android:exported="false" />

        <!-- Reschedule reminder alarms on boot / app update. Must be exported=true to
             receive the system BOOT_COMPLETED / MY_PACKAGE_REPLACED broadcasts (sent
             from another UID); it reads no intent extras (see BootReceiver). -->
        <receiver
            android:name=".surface.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FCM receiver (dormant until google-services.json is added). -->
        <service
            android:name=".surface.UnstuckMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Glance Start-Next home-screen widget. -->
        <receiver
            android:name=".surface.StartNextWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/start_next_widget_info" />
        </receiver>
    </application>
</manifest>
