<?xml version="1.0" encoding="utf-8"?>
<!-- The Unstuck Orbit logo (mark.svg), scaled into the adaptive-icon viewport:
     ink anchor + ~290° ink ring with the gap at 3 o'clock + a coral satellite
     dot in the gap. On the light tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ink ring (arc, gap + satellite at 3 o'clock) -->
    <path
        android:strokeColor="#1A1C26"
        android:strokeWidth="5.06"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 78.15,54 A 24.15,24.15 0 1 0 69.18,72.63" />
    <!-- ink anchor -->
    <path
        android:fillColor="#1A1C26"
        android:pathData="M54,54 m-7.82,0 a7.82,7.82 0 1,0 15.64,0 a7.82,7.82 0 1,0 -15.64,0" />
    <!-- coral satellite dot -->
    <path
        android:fillColor="#E89077"
        android:pathData="M78.15,54 m-4.83,0 a4.83,4.83 0 1,0 9.66,0 a4.83,4.83 0 1,0 -9.66,0" />
</vector>
